# BacktestEdge API proxy target for Vite dev server.
# Allowed aliases:
# - prod  -> https://bt2api.sentimentrader.com
# - dev   -> https://devbt2api.sentimentrader.com
# - local -> http://localhost:5001
# You can also use a full URL, for example:
# VITE_ST_API_PROXY_TARGET=https://bt2api.sentimentrader.com
VITE_ST_API_PROXY_TARGET=prod

# Optional: override the built-in local development sentimen_session test cookie.
# This is read by the Vite dev server for local cookies and proxied API requests.
# Do not expose this in production builds.
DEV_SENTIMEN_SESSION=

# Old vue.config.js kept /api on the local backend and preserved the /api prefix.
VITE_LOCAL_API_PROXY_TARGET=http://localhost:5001

# Optional proxies migrated from the old project.
VITE_AI_PROXY_TARGET=https://ai.sentdevsite.com
VITE_SN_PROXY_TARGET=http://192.168.2.101:5000
VITE_AGENT_PROXY_TARGET=http://localhost:8000
