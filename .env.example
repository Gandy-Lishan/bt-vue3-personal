# ── Backend API ─────────────────────────────────────────────────────
# Dev mode: Vite /api proxy target (can be alias or full URL)
# Allowed aliases for ST_API_PROXY_TARGET:
# - prod  -> https://bt2api.sentimentrader.com
# - dev   -> https://devbt2api.sentimentrader.com
# - local -> http://localhost:5001
VITE_ST_API_PROXY_TARGET=prod

# Production: direct CORS baseURL for stApi (full URL, no trailing slash)
# When set, stApi requests go directly to this URL instead of /api proxy.
VITE_ST_API_BASE_URL=

# ── Recurly ─────────────────────────────────────────────────────────
VITE_RECURLY_PUBLIC_API_KEY=

# ── reCAPTCHA ───────────────────────────────────────────────────────
VITE_GOOGLE_CAPTCHA_SITE_KEY=

# ── Other proxies (optional) ────────────────────────────────────────
VITE_AI_PROXY_TARGET=https://ai.sentdevsite.com
VITE_SN_PROXY_TARGET=http://192.168.2.101:5000
VITE_AGENT_PROXY_TARGET=http://localhost:8000

# ── Legacy ──────────────────────────────────────────────────────────
# Old vue.config.js kept /api on the local backend.
VITE_LOCAL_API_PROXY_TARGET=http://localhost:5001
